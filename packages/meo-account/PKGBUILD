pkgname=meo-account
pkgver=0.1.0
pkgrel=11
pkgdesc="Meo Account broker and authentication dialog for MeoArch"
arch=('x86_64')
url='https://github.com/QwQdoge/MeoArch-account'
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'kwallet' 'meoui-qml>=1.0.4beta1')
makedepends=('cmake' 'ninja' 'qt6-tools')
backup=('etc/meo-account/broker.conf')
source=()
sha256sums=()

build() {
  cmake -S "$srcdir/source/desktop" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # This file contains only public OAuth metadata and must be readable by the
  # per-user meo-accountd process.
  install -Dm644 "$srcdir/source/desktop/data/broker.conf.example" \
    "$pkgdir/etc/meo-account/broker.conf"

  # Meo Settings intentionally observes the broker instead of activating it
  # merely to render the Accounts page. Make the broker part of every graphical
  # user session so Account state is available before Settings asks for it.
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../meo-accountd.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/meo-accountd.service"
}

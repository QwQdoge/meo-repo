pkgname=meoui-qml
pkgver=1.0.3beta1
pkgrel=1
pkgdesc="MeoUI Qt Quick Material Design 3 component library"
arch=('x86_64')
url='https://github.com/QwQdoge/MeoUI'
license=('MIT')
depends=('qt6-declarative')
makedepends=('cmake' 'ninja' 'qt6-tools')
source=()
sha256sums=()

build() {
  cmake -B build -S "$srcdir/source" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DMEOUI_BUILD_SHOWCASE=OFF
  cmake --build build
}

package() { DESTDIR="$pkgdir" cmake --install build; }

# Rendered by the protected release job with source tag/commit/checksum from a manifest.
pkgname=meoui-qml
pkgver=1.0.3
pkgrel=1
pkgdesc="MeoUI Qt Quick Material Design 3 component library"
arch=('x86_64')
url='https://github.com/QwQdoge/MeoUI'
license=('MIT')
depends=('qt6-declarative' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'qt6-tools')
# The reviewed minimal train does not publish implicit split debug packages.
# MeoKDE's application style links the exported meoui_tokens CMake target.
options=('!debug' 'staticlibs')
source=()
sha256sums=()

build() {
  cmake -B build -S "$srcdir/source" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DMEOUI_BUILD_SHOWCASE=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/source/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

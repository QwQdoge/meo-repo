pkgname=meo-keyring
pkgver=1
pkgrel=3
pkgdesc="MeoArch pacman signing keyring"
arch=('any')
license=('MIT')
# Public bootstrap payload is reviewed under files/. Private key material is
# never a package source.
# render_keyring_recipe.py stages these reviewed files beside the recipe.
install=meo-keyring.install
source=('meo.gpg' 'meo-trusted' 'meo-revoked' 'meo-keyring.install')
sha256sums=('67912eaaab10f6b57658c9aad9854bd8023cc99e3cb99a2320d5c175ec87e5e9' '53044baf901563b0ee354ae995ecd702b461b00319a5461df269882e2f1d8bfb' 'bf84cedbff5a2ed7f27e1c39fba21db4bf54807190219248f245d47149e224f8' 'bc986e07bd2b6fd89946aa3f5f806a76b23fe2bc782d70571b44a7ddedd72602')

package() {
  install -Dm644 "$startdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  for keyring_file in meo.gpg meo-trusted meo-revoked; do
    test -s "$srcdir/$keyring_file" || {
      error "Refusing to build an empty Meo keyring payload: $keyring_file"
      return 1
    }
    install -Dm644 "$srcdir/$keyring_file" \
      "$pkgdir/usr/share/pacman/keyrings/$keyring_file"
  done
}

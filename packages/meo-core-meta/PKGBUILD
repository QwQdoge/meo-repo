pkgname=meo-core-meta
pkgver=2026.09
pkgrel=3
pkgdesc="Meo Desktop core package for MeoArch"
arch=('any')
license=('MIT')
depends=('meo-release' 'meo-desktop' 'meo-plasma-login-manager')
source=()
sha256sums=()

package() {
  install -Dm644 "$startdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/package-note" <<'EOF'
This dependency-only package installs the supported Meo Desktop core for MeoArch.
EOF
}

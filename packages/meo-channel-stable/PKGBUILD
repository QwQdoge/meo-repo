pkgname=meo-channel-stable
pkgver=1
pkgrel=1
pkgdesc="Select the MeoArch stable pacman channel"
arch=('any')
license=('MIT')
depends=('meo-mirrorlist')
provides=('meo-channel')
conflicts=('meo-channel-beta')
source=('meo-channel.conf')
sha256sums=('1909258d5eca4bebe2d7ee2ee19297b714b8eb425f88bf00408dc782e0b90322')

package() {
  install -Dm644 "$startdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 meo-channel.conf "$pkgdir/etc/pacman.d/meo-channel.conf"
}

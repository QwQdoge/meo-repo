pkgname=meo-settings
pkgver=0.2.0beta5
pkgrel=3
pkgdesc="Meo Settings application for MeoArch"
arch=('x86_64')
url='https://github.com/QwQdoge/MeoSettings'
license=('GPL-3.0-or-later')
depends=('meo-account' 'meo-icon-studio>=0.1.0' 'meoui-qml>=1.0.4beta1' 'meo-kde-runtime>=0.4.0beta3'
         'qt6-declarative' 'qt6-svg' 'qt6-multimedia' 'kservice' 'libkscreen' 'kconfig' 'kcoreaddons' 'ki18n' 'solid')
makedepends=('cmake' 'ninja' 'qt6-tools' 'extra-cmake-modules')
source=()
sha256sums=()

build() {
  cmake -S "$srcdir/source" -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/source/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

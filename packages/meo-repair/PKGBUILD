pkgname=meo-repair
pkgver=0.1.0
pkgrel=1
pkgdesc="Meo Repair diagnostics and consent-gated system repair for MeoArch"
arch=('x86_64')
url='https://github.com/QwQdoge/MeoArch-os-workspace'
license=('GPL-3.0-or-later')
depends=('meoui-qml>=1.0.4beta1' 'qt6-base' 'qt6-declarative' 'qtkeychain-qt6' 'polkit-qt6')
makedepends=('cmake' 'ninja' 'qt6-tools')
options=('!debug')
source=()
sha256sums=()

# The release renderer stages the pinned MeoArch workspace at $srcdir/source.
# Repair is deliberately built from that source train so its shared
# installer/repair controller cannot drift from the installed recovery stack.
build() {
  cmake -S "$srcdir/source/repair" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc
  cmake --build build --parallel
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/source/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

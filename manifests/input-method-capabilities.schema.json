{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meoarch.org/schemas/input-method-capabilities/v1",
  "title": "MeoArch input-method capability catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frameworks",
    "engines"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/framework"
      },
      "maxItems": 16
    },
    "engines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/engine"
      },
      "maxItems": 256
    }
  },
  "$defs": {
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9@._+:-]{0,127}$"
        },
        "role": {
          "enum": [
            "framework",
            "toolkit-bridge",
            "configuration",
            "engine",
            "integration"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "sessionModel",
        "packages",
        "modes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sessionModel": {
          "enum": [
            "wayland-user-session"
          ]
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packageRef"
          },
          "maxItems": 32
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "meo-managed"
            ]
          },
          "maxItems": 1
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "framework",
        "name",
        "languages",
        "packages",
        "sourcePolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
        },
        "framework": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
            "maxLength": 64
          },
          "maxItems": 32
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packageRef"
          },
          "maxItems": 32
        },
        "sourcePolicy": {
          "enum": [
            "configured-signed-repository"
          ]
        }
      }
    }
  }
}
